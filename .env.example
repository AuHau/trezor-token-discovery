# Copy to .env and fill in. Never commit .env.
RPC_URL=https://your-endpoint.example/your-key

# Network preset: ethereum (default) or linea. RPC_URL must serve the same chain;
# this is checked with eth_chainId at startup. Each chain gets its own store
# (./data for ethereum, ./data-<chain> otherwise) unless DATA_DIR is set.
# CHAIN=linea
# RPC_URL=https://rpc.linea.build
